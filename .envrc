# Loaded by direnv when entering this directory. See ops/RUNBOOK.md for setup.
#
# This file MUST NOT contain secrets — it's committed to the repo. Real
# values live in .env (gitignored) and load via dotenv_if_exists.

dotenv_if_exists

if [[ -z "${GH_TOKEN:-}" ]]; then
  log_status "GH_TOKEN not set; gh CLI will fall back to global identity (.env missing or empty?)"
fi

if [[ -z "${TAILSCALE_HOSTNAME:-}" ]]; then
  log_status "TAILSCALE_HOSTNAME not set; docker compose and cert scripts will fail (.env missing or empty?)"
fi
