# Copy this file to .env (gitignored) and fill in real values.
#   cp example.env .env

# Which Compose files to load. Compose merges them left-to-right.
# Dev machines: include the dev overlay so port 8000 is published to loopback.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# Prod server: set this in .env to use only the base file (no host port exposure):
#   COMPOSE_FILE=docker-compose.yml

# Bearer token used by the iOS app to authenticate to the API.
# Generate one with: openssl rand -hex 32
BEARER_TOKEN=replace-me

# Postgres password (used by docker-compose to provision the DB).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me

# OpenAI API key — used for embeddings (required from Phase 2 onward).
# Generate at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# OpenRouter API key — used for synthesis + classification (required from Phase 3 onward).
OPENROUTER_API_KEY=

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Per-token rate limits (token bucket, in-process memory).
# Burst capacity = rate × RATE_LIMIT_BURST_MULTIPLIER (bucket starts full).
# Increase these if legitimate usage exceeds the defaults; see RUNBOOK.md.
RATE_LIMIT_CAPTURE_PER_MIN=30
RATE_LIMIT_QUERY_PER_MIN=20
RATE_LIMIT_DEFAULT_PER_MIN=60
RATE_LIMIT_BURST_MULTIPLIER=2

# GitHub Personal Access Token, scoped to this repo only. Used by `gh` CLI
# (and agent automation) to act as the project's GitHub identity, overriding
# any globally set GITHUB_TOKEN. Generate a fine-grained PAT at:
#   https://github.com/settings/tokens?type=beta
# Repository access: only this repo. Permissions: read+write on Issues, Pull
# Requests, Contents, Metadata; read on Workflows.
GH_TOKEN=

# Tailscale MagicDNS hostname of this laptop. Used by the cert scripts and
# baked into the Apache vhost as ServerName at container start. Find yours
# with `tailscale status` — look for the line ending in `.ts.net` for this
# device. Format: <hostname>.<tailnet-id>.ts.net
TAILSCALE_HOSTNAME=your-laptop.tailXXXXXX.ts.net

# Host port that the Apache container binds for HTTPS. Defaults to 8443 to
# avoid conflicting with DDEV's router which holds port 443 on dev machines.
# On a dedicated production host with no DDEV, you can set this to 443.
GROVE_HTTPS_PORT=8443
