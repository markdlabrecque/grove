# Copy this file to .env (gitignored) and fill in real values.
#   cp example.env .env

# Bearer token used by the iOS app to authenticate to the API.
# Generate one with: openssl rand -hex 32
BEARER_TOKEN=replace-me

# Postgres password (used by docker-compose to provision the DB).
# Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-me

# OpenAI API key — used for embeddings (required from Phase 2 onward).
OPENAI_API_KEY=

# OpenRouter API key — used for synthesis + classification (required from Phase 3 onward).
OPENROUTER_API_KEY=

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# GitHub Personal Access Token, scoped to this repo only. Used by `gh` CLI
# (and agent automation) to act as the project's GitHub identity, overriding
# any globally set GITHUB_TOKEN. Generate a fine-grained PAT at:
#   https://github.com/settings/tokens?type=beta
# Repository access: only this repo. Permissions: read+write on Issues, Pull
# Requests, Contents, Metadata; read on Workflows.
GH_TOKEN=

# Tailscale MagicDNS hostname of this laptop. Used by the cert scripts and
# baked into the Apache vhost as ServerName at container start. Find yours
# with `tailscale status` — look for the line ending in `.ts.net` for this
# device. Format: <hostname>.<tailnet-id>.ts.net
TAILSCALE_HOSTNAME=your-laptop.tailXXXXXX.ts.net
