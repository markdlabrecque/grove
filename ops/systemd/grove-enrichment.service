[Unit]
Description=Grove enrichment worker (single run)
# Ensures Docker and the local Ollama inference server are up before the
# service fires. Enrichment calls local models (gpt-oss-20b for classification,
# bge-m3 for embeddings) through Ollama, so it must be ordered after it.
# Wants (not Requires) for ollama: a transient Ollama outage lets the run start
# and fail gracefully into enrichment_error + retry rather than being blocked.
After=docker.service ollama.service
Requires=docker.service
Wants=ollama.service

[Service]
Type=oneshot
# WorkingDirectory must be the directory containing docker-compose.yml.
# Adjust to the actual deploy path on the box (see RUNBOOK.md).
WorkingDirectory=/opt/grove

# Run as the system user that owns the Docker Compose project and is a member
# of the 'docker' group.  Change 'grove' to match what was created on the box.
User=grove

ExecStart=docker compose exec -T app python -m grove.enrichment.run

# journald captures stdout/stderr by default for systemd services;
# these two lines are explicit for clarity but have no net effect.
StandardOutput=journal
StandardError=journal
